# Database Configuration (PostgreSQL for Production)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Local Development (Use PostgreSQL or SQLite)
# DATABASE_URL="file:./db/custom.db"

# Agent Service URL (Update this with your Render worker URL after deployment)
NEXT_PUBLIC_AGENT_SERVICE_URL="http://localhost:3003"

# Production URLs (Set these in Render dashboard)
# DATABASE_URL will be auto-set by Render PostgreSQL
# NEXT_PUBLIC_AGENT_SERVICE_URL="https://kyper-dev-agent.onrender.com"

# Node Environment
NODE_ENV="production"

# Optional: Add your OpenRouter API keys here (or add via UI after deployment)
# OPENROUTER_API_KEY_1="sk-or-v1-..."
# OPENROUTER_API_KEY_2="sk-or-v1-..."
